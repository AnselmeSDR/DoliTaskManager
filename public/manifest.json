{
  "manifest_version": 3,
  "name": "DoliTaskManager",
  "version": "1.0",
  "description": "Extension to manage you dolibarr tasks and tickets with custom api",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.vold.lu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "popup.js",
        "assets/*"
      ],
      "matches": [
        "https://*.atlassian.net/*"
      ]
    }
  ]
}
